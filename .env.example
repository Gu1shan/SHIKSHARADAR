# Shiksha Radar Environment Variables
# Copy to .env and fill in values

# LLM API Keys (for SIH Prototype - optional for MVP)
# GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face (for embeddings - optional)
# HF_TOKEN=your_hf_token_here

# Database (for SIH Prototype)
# DATABASE_URL=sqlite:///./shiksha_radar.db

# Streamlit
# STREAMLIT_SERVER_PORT=8501